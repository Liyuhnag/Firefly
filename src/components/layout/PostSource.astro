---
import { type CollectionEntry, getEntry } from "astro:content";
import { siteConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import { getCategoryUrl, removeFileExtension, url } from "@/utils/url-utils";

interface Props {
	entry: CollectionEntry<"posts">;
}
const { entry } = Astro.props;
const project = entry.data.project ? await getEntry(entry.data.project) : undefined;
const showProject = project && siteConfig.pages.projects && (!import.meta.env.PROD || !project.data.draft);
const sourceName = showProject ? project.data.title : entry.data.category?.trim() || i18n(I18nKey.uncategorized);
const sourceUrl = showProject ? url(`/projects/${removeFileExtension(project.id)}/`) : getCategoryUrl(entry.data.category);
---
<p class="text-sm text-50">
  {showProject ? "来自项目" : "来自分类"} · <a href={sourceUrl} class="text-(--primary) hover:underline">{sourceName}</a>
</p>
